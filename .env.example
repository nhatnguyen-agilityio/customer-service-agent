# Copy this file to .env and fill in real values. Never commit .env itself.

# OpenAI
OPENAI_API_KEY=

# Supabase (new project, separate from custom-auth/'s)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Postgres connection string (Project Settings -> Database -> Connection string -> URI)
# used by the SQL toolkit, PostgresSaver checkpointer, and SupabaseVectorStore setup
SUPABASE_DB_URL=

# Serper API key for Google search 
SERPER_API_KEY=

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=customer-service-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
