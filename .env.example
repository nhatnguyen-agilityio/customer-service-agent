# Copy this file to .env and fill in real values. Never commit .env itself.

# OpenAI
OPENAI_API_KEY=

# Supabase (new project, separate from custom-auth/'s)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Postgres connection string (Project Settings -> Database -> Connection string -> URI)
# used by the PostgresSaver checkpointer (conversation memory) and SupabaseVectorStore setup
SUPABASE_DB_URL=
# Same connection string, but with the user/password swapped to the read-only
# `agent_readonly` role created in src/db/schema.sql. Used only by the SQL
# toolkit, so the agent can SELECT but never modify data.
SUPABASE_READONLY_DB_URL=

# Serper API key for Google search
SERPER_API_KEY=

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=customer-service-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional -- how far back to keep checkpoint history (scripts/prune_checkpoints.py).
# Any valid Postgres interval string. Defaults to "3 days" if unset.
CHECKPOINT_RETENTION_INTERVAL=3 days
